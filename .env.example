# Copia este archivo como `.env` y completa los valores reales.

# --- Supabase del CRM (propio, distinto del de hellominus.com y KAIROS) ---
# Cliente: seguras en el navegador porque el aislamiento real lo hace RLS.
# Ver supabase/README.md para crear el proyecto y correr el esquema.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# --- n8n (a partir del Sprint 2) ---
# URL del webhook de n8n que recibe el Flujo 1 (chat web de hellominus.com → CRM).
# Server-only si se usa desde una función serverless; no lleva prefijo VITE_.
N8N_WEBHOOK_URL=

# --- IA (Edge Function de Supabase, a partir del Sprint 3) ---
# Se configura como secret de la función (`supabase secrets set`), no acá.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Laboratorio RAG (Streamlit, solo para administradores de PLATAFORMA) ---
# Opcional. Sin esta variable no aparece el enlace "Laboratorio RAG" en la barra. Local:
# http://localhost:8501 (ver scripts/rag-laboratorio/README.md). Solo lo ve quien está en `platform_admins`.
# VITE_LABORATORIO_RAG_URL=http://localhost:8501
